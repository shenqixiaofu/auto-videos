# ==================================
# 生产环境配置模版
# 复制此文件为 .env.prod 并修改配置
# ==================================

ENVIRONMENT = "prod"

# 服务器配置
SERVER_HOST = "0.0.0.0"     # 允许访问的IP地址
SERVER_PORT = 8001          # 服务端口

# 文档配置
DEBUG = True                        # 调试模式
TITLE = "🎉 FastapiAdmin 🎉"    # 文档标题
VERSION = "0.1.0"                   # 版本号
SUMMARY = "接口汇总"                 # 文档概述
DOCS_URL = "/docs"                  # Swagger UI路径
REDOC_URL = "/redoc"                # ReDoc路径
ROOT_PATH = "/api/v1"               # API路由前缀
DESCRIPTION = "该项目是一个基于python的web服务框架，基于fastapi和sqlalchemy实现。"  # 文档描述

# 是否启用演示模式
DEMO_ENABLE = False

# 数据库配置
DATABASE_TYPE = "mysql"  # mysql、postgres、sqlite、dm(sqlite、dm不支持代码生成)

# 数据库配置
DATABASE_HOST = "your_mysql_host"
DATABASE_PORT = 3306  # MySQL:3306 PostgreSQL:5432
DATABASE_USER = "root"
DATABASE_PASSWORD = "your_mysql_password"
DATABASE_NAME = "smart_worker"

# Redis配置
REDIS_ENABLE = True 
REDIS_HOST = "your_redis_host"
REDIS_PORT = 6379
REDIS_USER = ""
REDIS_PASSWORD = ""
REDIS_DB_NAME = 1

# 日志配置
LOGGER_LEVEL = "DEBUG"   # 日志级别

# 大模型配置
OPENAI_BASE_URL = "https://api.deepseek.com"
OPENAI_API_KEY = "your_api_key"
OPENAI_MODEL = "deepseek-chat"


GLM_API_KEY = ""
GLM_API_URL = "https://ark.cn-beijing.volces.com/api/v3"
GLM_API_MODEL = "glm-4-7-251222"

# DOUBAO
DOUBAO_API_KEY = ""
DOUBAO_API_URL = "https://ark.cn-beijing.volces.com/api/v3"
DOUBAO_API_MODEL = "doubao-api-model"

# QWEN_API_KEY
QWEN_API_KEY = ""
QWEN_API_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"

# 火山引擎：仅 module_ai_image 的人脸融合/换脸在用
VOLC_AK = ""
VOLC_SK = "=="

# 智能视频 Worker 配置
VIDEO_WORKER_ENABLED = False
VIDEO_WORKER_SCAN_INTERVAL_SECONDS = 10
VIDEO_WORKER_CONCURRENCY = 2
VIDEO_WORKER_TASK_TIMEOUT_SECONDS = 3600
VIDEO_PREPROCESS_ENABLED = True
VIDEO_AUTO_EDITOR_TIMEOUT_SECONDS = 1800
VIDEO_SPEECH_PAUSE_TRIM_ENABLED = True
VIDEO_SPEECH_PAUSE_MIN_SECONDS = 0.8
VIDEO_RENDER_PROVIDER = "aliyun_ims"
VIDEO_RENDER_POLL_INTERVAL_SECONDS = 10
VIDEO_CLOUD_RETENTION_DAYS = 7

# 封面生图中转站（OpenAI 协议）。密钥留空时自动回退火山 Seedream 通道。
VIDEO_COVER_IMAGE_PROVIDER = "relay"
COVER_RELAY_API_URL = "https://newapi.dragon3api.com/v1"
COVER_RELAY_API_KEY = ""
COVER_RELAY_IMAGE_MODEL = "gpt-image-2.5"
COVER_RELAY_IMAGE_SIZE = "1024x1536"
ALIYUN_ACCESS_KEY_ID = ""
ALIYUN_ACCESS_KEY_SECRET = ""
ALIYUN_ICE_REGION = "cn-shanghai"
ALIYUN_ICE_ENDPOINT = "ice.cn-shanghai.aliyuncs.com"
ALIYUN_OSS_ENDPOINT = "https://oss-cn-shanghai.aliyuncs.com"
ALIYUN_OSS_BUCKET = ""
ALIYUN_OSS_OBJECT_PREFIX = "auto-nexus/video-render"
ALIYUN_OSS_PRESIGNED_EXPIRE_SECONDS = 3600

BANANA_API_KEY = ""
# 🪣 MinIO 对象存储配置
# ==========================================
# MinIO API 地址 (注意不要带 http://，只需 IP:端口，如 127.0.0.1:9000)
MINIO_ENDPOINT=your-minio-host:9000
MINIO_PUBLIC_ENDPOINT=https://your-minio-api.example.com

# 账号和密码
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# 存储桶名称
MINIO_BUCKET_NAME=auto-nexus

# 是否使用 HTTPS (本地测试填 False，线上配了证书填 True)
MINIO_SECURE=False
MINIO_PRESIGNED_EXPIRE_SECONDS=900
MINIO_MULTIPART_PART_SIZE=67108864
MINIO_MULTIPART_MAX_PARTS=10000
